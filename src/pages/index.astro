---
import Layout from '../layouts/Layout.astro';
import { getStatsData } from '../utils/stats-core.js';

const env = Astro.locals.runtime.env;
const context = Astro.locals.runtime.ctx;
const stats = await getStatsData(Astro.request, env, context);

const uptimeText = `${stats.uptime.days} days, ${stats.uptime.hours} hrs`;
const visitorsText = `${stats.visitors}`;
